# ---------------------------------------------------------------------------
# Antigravity Cloud Bridge - Environment Configuration Template
# ---------------------------------------------------------------------------

# Telegram Bot Credentials (Get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# Email Dispatch Configuration (Resend API)
RESEND_API_KEY=re_your_api_key_here
NOTIFICATION_EMAIL_RECIPIENT=your_email@example.com
SENDER_DEFAULT_IDENTITY=AI Assistant <noreply@yourdomain.com>
SENDER_DOMAIN=yourdomain.com

# AI Inference Engines
# NOTE: You only need ONE AI API key for the entire system to function.
# Adding multiple keys enables zero-downtime fallback if one provider hits rate limits (429) or goes down.
# Fallback priority: OpenAI -> Gemini -> OpenRouter
OPENAI_API_KEY=sk-proj-your-key-here
GEMINI_API_KEY=AIzaSy-your-key-here
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: Custom AI System Persona Prompt
SYSTEM_INSTRUCTION="You are an autonomous AI software engineering and development assistant. Strictly ZERO emojis."

# Local Buffer Storage Paths
INBOX_DIR=./inbox
LEDGER_FILE=./inbox/inbox_ledger.json
OFFSET_FILE=./inbox/.telegram_offset.json
NOTES_FILE=./inbox/mobile_notes.md

# Polling Interval (in seconds)
POLL_INTERVAL=3
